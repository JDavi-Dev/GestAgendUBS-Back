APP_NAME=SGA UBS API
APP_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=false

# Execução local sem Docker:
DATABASE_URL=postgresql+psycopg://sga_user:troque_a_senha@localhost:5432/sga_ubs

# Gere uma chave longa e aleatória antes de publicar.
JWT_SECRET_KEY=troque-esta-chave-por-uma-chave-aleatoria-com-mais-de-32-caracteres
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30
TIMEZONE=America/Fortaleza

CORS_ORIGINS=http://localhost:5173,http://localhost,http://127.0.0.1:5173

POSTGRES_DB=sga_ubs
POSTGRES_USER=sga_user
POSTGRES_PASSWORD=troque_a_senha

# Primeiro administrador. O entrypoint cria somente se os três campos principais forem informados.
BOOTSTRAP_ADMIN_NAME=Administrador SGA UBS
BOOTSTRAP_ADMIN_EMAIL=admin@sgaubs.com
BOOTSTRAP_ADMIN_PASSWORD=admin123
BOOTSTRAP_ADMIN_CPF=
BOOTSTRAP_ADMIN_PHONE=

# true apenas em ambiente de demonstração/desenvolvimento.
SEED_DEMO_DATA=false
